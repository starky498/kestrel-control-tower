# Required: supplied by the assignment pack; never committed to Git.
KESTREL_SOURCE_DB=/absolute/path/to/kestrel_ops.db

# Generated locally by `make build`.
KESTREL_ANALYTICS_DB=.kestrel/kestrel.duckdb

# Mock integrations shipped in the assignment pack.
KESTREL_FREIGHT_API_URL=http://127.0.0.1:8088
KESTREL_FREIGHT_API_KEY=replace-with-key-from-assignment-pack
KESTREL_BAZAARPULSE_BASE_URL=http://127.0.0.1:8080
# Optional: omit when the supplied site is unpacked at data/source/bazaarpulse_site.
# KESTREL_BAZAARPULSE_SITE_ROOT=/absolute/path/to/bazaarpulse_site

# Optional context. These are contacted only by `kestrel sync-context`.
KESTREL_WEATHER_API_URL=https://archive-api.open-meteo.com/v1/archive
KESTREL_HOLIDAY_API_URL=https://date.nager.at/api/v3/PublicHolidays
# Used only when Nager.Date reports that country IN is unsupported.
KESTREL_HOLIDAY_FALLBACK_URL=https://calendar.google.com/calendar/ical/en.indian%23holiday%40group.v.calendar.google.com/public/basic.ics
# KESTREL_WEATHER_CACHE=.kestrel/weather_daily.json
# KESTREL_HOLIDAY_CACHE=.kestrel/india_holidays.json

# Governed assumptions.
KESTREL_NEAR_EXPIRY_DAYS=30
KESTREL_COMPETITOR_MATCH_THRESHOLD=86
